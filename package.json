{
  "name": "naturalcodz",
  "version": "0.1.0",
  "description": "Natural logic utilities powered by Jev AI — classify, guard, route, score, and check with confidence-aware AI primitives",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SuparvaCode/NaturalCodes.git"
  },
  "bugs": {
    "url": "https://github.com/SuparvaCode/NaturalCodes/issues"
  },
  "homepage": "https://github.com/SuparvaCode/NaturalCodes#readme",
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run lint && npm test && npm run build"
  },
  "keywords": [
    "ai",
    "natural-language",
    "classification",
    "guardrails",
    "routing",
    "scoring",
    "jev",
    "typesafe",
    "system-one",
    "confidence",
    "nlp",
    "decision-making"
  ],
  "author": "Suparva",
  "license": "MIT",
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
